/** '9과04-04' → 4 */
function areaNoOf(code) {
  const m = String(code).match(/^9과(\d{2})-/);
  return m ? parseInt(m[1], 10) : 0;
}

function getAreas() {
  const seen = {}, list = [];
  STANDARDS.forEach(function (s) {
    const no = areaNoOf(s.c);
    if (!seen[no]) { seen[no] = 1; list.push({ no: no, name: s.a }); }
  });
  return list.sort(function (x, y) { return x.no - y.no; });
}

function getStandardsByArea(areaNo) {
  return STANDARDS.filter(function (s) { return areaNoOf(s.c) === Number(areaNo); });
}

function findStandard(code) {
  for (var i = 0; i < STANDARDS.length; i++) if (STANDARDS[i].c === code) return STANDARDS[i];
  return null;
}
